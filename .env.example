# Copia este archivo como .env para correr el bot en tu computadora. NUNCA subas .env a GitHub.
# En GitHub, estos mismos valores van en Settings > Secrets and variables > Actions.

# Acciones/ETFs - Alpaca. Una cuenta paper es gratis y no usa dinero real.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Criptos - Bitso. Crea la llave con permisos de ver saldo y operar. Retiros DESACTIVADOS.
BITSO_API_KEY=
BITSO_API_SECRET=

# Tercer candado para dinero real. Déjalo vacío mientras estés en simulado.
CONFIRMO_DINERO_REAL=
