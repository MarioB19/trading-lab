#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl docker.io python3 util-linux e2fsprogs logrotate
if ! command -v gcloud >/dev/null; then
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg -o /usr/share/keyrings/cloud.google.asc
  echo 'deb [signed-by=/usr/share/keyrings/cloud.google.asc] https://packages.cloud.google.com/apt cloud-sdk main' >/etc/apt/sources.list.d/google-cloud-sdk.list
  apt-get update
  apt-get install -y google-cloud-cli
fi
systemctl enable --now docker
install -d -m 0755 /etc/trading-lab /usr/local/lib/trading-lab /var/log/trading-lab
mount_data_disk() {
  local disk=$1 target=$2 uuid filesystem fstab_entry
  [ ! -L "$target" ] || { echo 'Refusing symlink mountpoint' >&2; return 1; }
  install -d -m 0755 "$target"
  for attempt in $(seq 1 60); do [ -b "$disk" ] && break; sleep 2; done
  [ -b "$disk" ] || { echo "Dedicated disk missing: $disk" >&2; return 1; }
  # Format ONLY an unformatted dedicated disk; never an existing filesystem.
  if ! blkid "$disk" >/dev/null 2>&1; then
    # Refuse unknown nonblank media instead of treating a failed probe as empty.
    [ -z "$(wipefs --no-act --noheadings "$disk")" ] && cmp --bytes=1048576 "$disk" /dev/zero || {
      echo 'Unknown nonblank dedicated disk; refusing to format' >&2; return 1;
    }
    mkfs.ext4 -F "$disk"
  fi
  filesystem=$(blkid -s TYPE -o value "$disk")
  [ "$filesystem" = ext4 ] || { echo 'Dedicated disk must already be ext4' >&2; return 1; }
  uuid=$(blkid -s UUID -o value "$disk")
  [ -n "$uuid" ] || { echo 'Dedicated disk has no UUID' >&2; return 1; }
  fstab_entry="UUID=$uuid $target ext4 defaults,nodev,nosuid 0 2"
  if awk -v target="$target" '$1 !~ /^#/ && $2 == target { found=1 } END { exit !found }' /etc/fstab; then
    grep -Fxq "$fstab_entry" /etc/fstab || { echo 'Conflicting fstab entry; refusing mount' >&2; return 1; }
  else
    printf '%s\n' "$fstab_entry" >>/etc/fstab
  fi
  if ! mountpoint -q "$target"; then
    [ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ] || {
      echo 'Refusing to hide files under dedicated mountpoint' >&2; return 1;
    }
    mount "$target"
  fi
  [ "$(findmnt -n -o UUID --mountpoint "$target")" = "$uuid" ] || {
    echo 'Wrong filesystem mounted on dedicated path' >&2; return 1;
  }
  chown 10001:10001 "$target"
  chmod 0750 "$target"
}
mount_data_disk /dev/disk/by-id/google-trading-state /var/lib/trading-lab
%{ if experimental_storage ~}
mount_data_disk /dev/disk/by-id/google-trading-experiments /var/lib/trading-experiments
# Storage only: experimental scripts/timers/activation markers are NOT installed.
for directory in /var/lib/trading-experiments/aggressive-v2 /var/lib/trading-experiments/backups; do
  [ ! -L "$directory" ] || { echo 'Refusing symlink experiment directory' >&2; exit 1; }
  install -d -o 10001 -g 10001 -m 0700 "$directory"
done
%{ endif ~}
cat >/etc/trading-lab/settings.conf <<'SETTINGS'
PROJECT_ID='${project_id}'
REGISTRY_HOST='${region}-docker.pkg.dev'
BACKUP_BUCKET='${bucket}'
DATA_DIR='/var/lib/trading-lab'
SETTINGS
printf '%s' '${paper_refs_b64}' | base64 -d >/etc/trading-lab/paper-secret-refs.json
chmod 0600 /etc/trading-lab/settings.conf /etc/trading-lab/paper-secret-refs.json
%{ for path, entry in files ~}
printf '%s' '${base64encode(entry.content)}' | base64 -d >'${path}'
chmod ${entry.mode} '${path}'
%{ endfor ~}
# Never enables the worker. Explicit lab.ops activate is required after cutover.
%{ if image_uri != "" ~}
if [ ! -f /etc/trading-lab/release.conf ]; then
  /usr/local/lib/trading-lab/install-release.sh '${image_uri}' '${source_sha}'
fi
%{ endif ~}
if ! command -v google_cloud_ops_agent_engine >/dev/null && ! systemctl cat google-cloud-ops-agent >/dev/null 2>&1; then
  curl -fsSL https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh -o /run/install-ops-agent.sh
  bash /run/install-ops-agent.sh --also-install
  rm -f /run/install-ops-agent.sh
fi
cat >/etc/google-cloud-ops-agent/config.yaml <<'OPS'
logging:
  receivers:
    trading_health:
      type: files
      include_paths: [/var/log/trading-lab/health.jsonl]
    trading_containers:
      type: files
      include_paths: [/var/lib/docker/containers/*/*-json.log]
      record_log_file_path: true
  processors:
    json:
      type: parse_json
  service:
    pipelines:
      trading_health:
        receivers: [trading_health]
        processors: [json]
      trading_containers:
        receivers: [trading_containers]
        processors: [json]
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
  service:
    pipelines:
      default_pipeline:
        receivers: [hostmetrics]
OPS
cat >/etc/logrotate.d/trading-lab <<'ROTATE'
/var/log/trading-lab/*.jsonl {
  daily
  rotate 7
  size 5M
  missingok
  notifempty
  copytruncate
  compress
}
ROTATE
systemctl daemon-reload
systemctl restart google-cloud-ops-agent
systemctl enable trading-lab-api.service trading-lab-worker.service trading-lab-backup.timer trading-lab-health.timer
systemctl start trading-lab-api.service trading-lab-backup.timer trading-lab-health.timer
